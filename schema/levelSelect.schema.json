{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": { "$ref": "#/$defs/level" },
  "$defs": {
    "level": {
      "type": "object",
      "properties": {
        "levelID": { "type": "string" },
        "levelName": { "type": "string" },
        "title": { "type": "string" },
        "levelFile": { "type": "string" },
        "sideQuest": {
          "type": "array",
          "items": { "$ref": "#/$defs/level" }
        }
      },
      "required": ["levelID", "levelName", "title", "levelFile"]
    }
  }
}