{
  "rust-analyzer.linkedProjects": [
    "src-tauri/Cargo.toml"
  ],
  "rust-analyzer.files.exclude": [
    "src-tauri/src/utils/rjs/"
  ],
  "files.watcherExclude": {
    ".git/objects/**": true,
    ".git/subtree-cache/**": true,
    ".hg/store/**": true,
    "*/.git/objects/**": true,
    "*/.git/subtree-cache/**": true,
    "*/.hg/store/**": true,
    "src-tauri/src/utils/rjs/**":true,
    "rjs-vscode/**":true
  },
  "json.schemas": [
    {
      "fileMatch": ["/res-dev/level/levelSelect.json"],
      "url": "/schema/levelSelect.schema.json"
    }
  ]
}